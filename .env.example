# ──────────────────────────────────────────────────────────────────────────────
# LifeLoop — Environment Variables Example
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Development database (local only) ─────────────────────────────────────────
# Must point to a LOCAL PostgreSQL instance (loopback host).
# The server refuses to start if this resolves to a non-loopback host
# that is not listed in DEV_DB_ALLOWED_HOSTS.
# Create the database first:
#   createdb -h 127.0.0.1 -p 5433 -U postgres lifeloop_dev_db
# Then apply schema:
#   npm run db:migrate:dev
DATABASE_URL=postgres://postgres@127.0.0.1:5433/lifeloop_dev_db

# ── Dev DB allowlist (optional) ───────────────────────────────────────────────
# Comma-separated additional hostnames that are permitted as DATABASE_URL hosts
# in development (e.g. a staging Neon branch you explicitly trust).
# Hostnames are compared after stripping "-pooler" and lowercasing.
# Leave blank to restrict to loopback only (recommended).
DEV_DB_ALLOWED_HOSTS=

# ── Production host guard ─────────────────────────────────────────────────────
# Set this to your production database hostname (without credentials).
# The server refuses to start in development if DATABASE_URL resolves to this
# host, even if the host is listed in DEV_DB_ALLOWED_HOSTS.
# Example: PROD_DB_HOST=ep-autumn-firefly-azqtkeow.c-3.ap-southeast-1.aws.neon.tech
PROD_DB_HOST=<production host only>

# ── JWT secret ────────────────────────────────────────────────────────────────
JWT_SECRET=your-local-dev-secret-change-me

# ── Google OAuth (Hybrid Auth) ────────────────────────────────────────────────
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Required for "Continue with Google" sign-in / registration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=64532
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# Do not set HOST=0.0.0.0 locally.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Required in production. In development, set AI_PROVIDER=mock to skip.
GEMINI_API_KEY=your-gemini-api-key-here

# Storage
S3_BUCKET_NAME=your_bucket_name
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Email Provider
EMAIL_PROVIDER=<placeholder> # mock | resend | smtp
EMAIL_FROM=<placeholder>
SMTP_HOST=<placeholder>
SMTP_PORT=<placeholder>
SMTP_SECURE=<placeholder>
SMTP_USER=<placeholder>
SMTP_PASS=<placeholder>

# ── AI provider ───────────────────────────────────────────────────────────────
# Set to "mock" in local development to avoid consuming API quota.
# Must NOT be "mock" in production (the server will refuse to start).
AI_PROVIDER=mock

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to "1" only in development/test. Must NOT be "1" in production.
DISABLE_RATE_LIMIT=1
